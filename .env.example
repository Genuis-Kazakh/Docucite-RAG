# --- Paths ---
DATA_DIR=data
# --- Chunking ---
CHUNK_SIZE=500
CHUNK_OVERLAP=80
# --- Retrieval ---
TOP_K=4
EMBEDDING_MODEL=sentence-transformers/paraphrase-multilingual-MiniLM-L12-v2
EMBEDDING_BACKEND=sentence-transformers   # "hash" = offline mode without model download
MIN_SCORE=0.25
# --- LLM (OpenAI-compatible) ---
LLM_BASE_URL=https://api.openai.com/v1
LLM_API_KEY=sk-your-key-here
LLM_MODEL=gpt-4o-mini
# Optional: comma-separated backup models, tried in order if the main one is overloaded or out of quota
LLM_FALLBACK_MODELS=

# --- Security (optional) ---
# Leave ACCESS_KEY empty for local use only. Set a long random value before sharing or deploying.
ACCESS_KEY=
# Set to false to hide /docs and /openapi.json
ENABLE_DOCS=true
